ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# IPs or ranges that can use the ComfyUI API without a login, e.g. localhost and Tailscale
TRUSTED_IPS=127.0.0.1,::1,100.64.0.0/10
# Folder for the database, images, thumbnails and sessions (default: data/ in the repo)
# DATA_DIR=/srv/prompt-manager
# ComfyUI address, and workflows (exported with "Export (API)") for the generate buttons
# COMFYUI_URL=http://localhost:8188
# CHARACTER_FRONT_WORKFLOW=workflows/character_front.json
# One workflow for all 6 views; the app sets the view on 加载角色参考图 and 保存角色图
# CHARACTER_VIEW_WORKFLOW=workflows/character_view.json
# SCENE_WORKFLOW=workflows/scene.json
